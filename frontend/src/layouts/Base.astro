---
// Fuentes autoalojadas (sin Google Fonts en remoto): Fraunces con ejes de peso y tamaño óptico, y Manrope.
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
// Fuentes del primer pantallazo (titular y texto), precargadas para no retrasar el LCP
import fuenteTitular from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import fuenteTitularCursiva from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-italic.woff2?url';
import fuenteTexto from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import type { Lang } from '../data/restaurante';
import { t, rutaIdioma } from '../i18n/textos';

interface Props {
  lang: Lang;
  /** Título propio (páginas legales, 404). Si no se da, el de la portada. */
  titulo?: string;
  /** Ruta equivalente en cada idioma, para hreflang y canonical. */
  rutas?: Record<Lang, string>;
  /** Fuerza noindex (p. ej. la 404). */
  noindex?: boolean;
}
const { lang, titulo, rutas = rutaIdioma, noindex = false } = Astro.props;
const tx = t(lang);
const canonical = new URL(rutas[lang], Astro.site);
// Mientras la web esté en vista previa (datos por confirmar) no se indexa.
// El día del lanzamiento: PUBLIC_INDEXAR=true en Netlify.
const indexar = import.meta.env.PUBLIC_INDEXAR === 'true' && !noindex;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={fuenteTitular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fuenteTitularCursiva} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fuenteTexto} as="font" type="font/woff2" crossorigin />
    <title>{titulo ?? tx.meta.titulo}</title>
    <meta name="description" content={tx.meta.descripcion} />
    <link rel="canonical" href={canonical} />
    {!indexar && <meta name="robots" content="noindex, nofollow" />}
    <link rel="alternate" hreflang="es" href={new URL(rutas.es, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(rutas.en, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(rutas.es, Astro.site)} />
    <meta name="theme-color" content="#17120f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="restaurant" />
    <meta property="og:site_name" content="Parrilla Príncipe" />
    <meta property="og:title" content={titulo ?? tx.meta.titulo} />
    <meta property="og:description" content={tx.meta.descripcion} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <slot name="head" />
  </head>
  <body>
    <a class="salto" href="#contenido">{tx.nav.saltar}</a>
    <slot />
  </body>
</html>
