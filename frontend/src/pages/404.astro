---
/** Página 404 con el mismo diseño, en los dos idiomas (el servidor no sabe en qué idioma navegaba la visita). */
import Base from '../layouts/Base.astro';
import { t } from '../i18n/textos';
import { restaurante } from '../data/restaurante';

const es = t('es').error404;
const en = t('en').error404;
---
<Base lang="es" titulo="Página no encontrada · Parrilla Príncipe" noindex>
  <main id="contenido" class="error oscuro">
    <div class="contenedor">
      <span class="marcas" aria-hidden="true"></span>
      <p class="error__codigo" aria-hidden="true">404</p>
      <h1>{es.titulo}</h1>
      <p>{es.texto}</p>
      <div class="error__acciones">
        <a class="boton boton--ambar" href="/">{es.volver}</a>
        <a class="boton boton--claro" href={restaurante.telefono.enlace}>{restaurante.telefono.visible}</a>
      </div>
      <div class="error__en" lang="en">
        <h2>{en.titulo}</h2>
        <p>{en.texto} <a href="/en/">{en.volver}</a></p>
      </div>
    </div>
  </main>
</Base>

<style>
  .error { min-height: 100svh; display: flex; align-items: center; padding-block: 6rem; }
  .error__codigo {
    margin: 1.5rem 0 0; font-family: var(--font-display); font-weight: 300; font-style: italic;
    font-size: clamp(5rem, 16vw, 11rem); line-height: 0.9; color: var(--color-ambar);
  }
  .error h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); font-weight: 300; margin: 1rem 0 1.25rem; max-width: 20ch; }
  .error p { max-width: 48ch; color: var(--color-humo); }
  .error__acciones { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .error__en { margin-top: 4rem; padding-top: 2rem; border-top: 1px solid rgb(242 233 218 / 0.15); }
  .error__en h2 { font-size: 1.6rem; font-weight: 300; margin: 0 0 0.5rem; }
  .error__en a { color: var(--color-ambar); }
</style>
