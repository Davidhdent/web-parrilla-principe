---
/**
 * Hero: el Monasterio a pantalla completa (Ken Burns) y el titular revelado letra a letra.
 * Todo con CSS generado en el servidor: no espera a ningún JavaScript (LCP rápido)
 * y el texto está en el HTML inicial.
 * La foto (aportada por el restaurante) mide 604 px: sustituir por el original en más resolución.
 */
import { Picture } from 'astro:assets';
import type { Lang } from '../data/restaurante';
import { restaurante } from '../data/restaurante';
import { fotos } from '../data/imagenes';
import { t } from '../i18n/textos';
import Icono from './Icono.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = t(lang);

// Titular: cada palabra en un bloque que no se parte; cada letra con su retraso.
let n = 0;
const palabras = tx.hero.titular.split(' ').map((p, i) => ({
  enfasis: i >= tx.hero.enfasisDesde,
  letras: [...p].map((l) => ({ l, i: n++ })),
}));

// Anchos generados: sin pasar del original (Astro no amplía; si llega una foto mayor, salen más tamaños).
const foto = fotos.monasterioVista.src;
const anchos = [480, 800, 1280, 1600, 2000].filter((w) => w < foto.width).concat(foto.width);
---
<section class="hero oscuro" aria-labelledby="hero-titulo">
  <div class="hero__imagen">
    <Picture
      src={foto}
      formats={['avif', 'webp']}
      widths={anchos}
      sizes="100vw"
      alt={tx.hero.imagenAlt}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="hero__velo" aria-hidden="true"></div>

  <div class="hero__contenido contenedor">
    <p class="hero__antetitulo" data-hero-aparece><span class="marcas" aria-hidden="true"></span>{tx.hero.antetitulo}</p>
    <h1 id="hero-titulo" class="hero__titular">
      <span class="sr-only">{tx.hero.titular}</span>
      <span aria-hidden="true">
        {palabras.map((p, i) => (
          <><span class:list={['palabra', { enfasis: p.enfasis }]}>{p.letras.map(({ l, i: k }) => <span class="letra" style={`--i:${k}`}>{l}</span>)}</span>{i < palabras.length - 1 && ' '}</>
        ))}
      </span>
    </h1>
    <p class="hero__entradilla" data-hero-aparece>{tx.hero.entradilla}</p>
    <div class="hero__acciones" data-hero-aparece>
      <a class="boton boton--ambar" href={restaurante.telefono.enlace}>
        <Icono nombre="telefono" />{tx.acciones.llamar}
      </a>
      <a class="boton boton--claro" href="#carta">{tx.acciones.verCarta}</a>
    </div>
  </div>

  <p class="hero__direccion" data-hero-aparece>
    {restaurante.direccion.calle}<br />{restaurante.direccion.localidad}
  </p>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
  }
  .hero__imagen { position: absolute; inset: 0; z-index: -3; }
  .hero__imagen :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: 55% 30%;
    transform-origin: 55% 30%;
    animation: hero-kenburns 26s ease-out both;
  }
  /* Zoom corto: la foto actual es pequeña y ampliarla más la emborronaría */
  @keyframes hero-kenburns {
    from { transform: scale(1.08) translate3d(1%, 0.5%, 0); }
    to { transform: scale(1) translate3d(0, 0, 0); }
  }
  /* Velo: el Monasterio queda visible arriba y el texto se lee sobre la parte baja */
  .hero__velo {
    position: absolute; inset: 0; z-index: -2;
    background:
      linear-gradient(to top, rgb(23 18 15 / 0.95) 0%, rgb(23 18 15 / 0.8) 32%, rgb(23 18 15 / 0.25) 62%, rgb(23 18 15 / 0.1) 100%),
      linear-gradient(95deg, rgb(23 18 15 / 0.55) 0%, transparent 60%),
      linear-gradient(to bottom, rgb(23 18 15 / 0.55), transparent 22%);
  }
  /* En móvil el texto ocupa más altura y se monta sobre el edificio: velo más alto */
  @media (max-width: 48rem) {
    .hero__velo {
      background:
        linear-gradient(to top, rgb(23 18 15 / 0.95) 0%, rgb(23 18 15 / 0.85) 50%, rgb(23 18 15 / 0.35) 75%, rgb(23 18 15 / 0.15) 100%),
        linear-gradient(to bottom, rgb(23 18 15 / 0.55), transparent 22%);
    }
  }

  .hero__contenido { padding-block: 8rem clamp(5.5rem, 11vh, 7.5rem); }
  .hero__antetitulo {
    display: flex; align-items: center; gap: 0.9rem; margin: 0 0 1.5rem;
    font-family: var(--font-display); font-style: italic; font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    color: var(--color-ambar);
  }
  .hero__titular {
    /* «Fraunces Titular» = Fraunces con font-display: optional (Base.astro) + reserva calibrada:
       el titular nunca salta al llegar la fuente (CLS) */
    font-family: "Fraunces Titular", "Fraunces titular fallback", Georgia, serif;
    font-size: clamp(2.9rem, 7.6vw, 7.4rem);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.025em;
    /* En em, no en ch: «ch» depende de la fuente cargada y el ancho cambiaba al llegar Fraunces (CLS) */
    max-width: 8.5em;
    margin: 0 0 clamp(1.5rem, 3.5vh, 2.25rem);
  }
  .palabra { display: inline-block; white-space: nowrap; }
  .enfasis { font-style: italic; color: var(--color-ambar); }
  .letra {
    display: inline-block;
    animation: hero-letra 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(0.05s + var(--i) * 18ms);
  }
  /* Opacidad inicial mínima pero no nula: el navegador cuenta el titular como pintado
     desde el primer fotograma (LCP) y la animación se ve igual. */
  @keyframes hero-letra { from { opacity: 0.01; transform: translateY(0.35em); } }
  [data-hero-aparece] {
    animation: hero-aparece 1s ease-out both;
    animation-delay: 0.9s;
  }
  @keyframes hero-aparece { from { opacity: 0; transform: translateY(16px); } }

  .hero__entradilla {
    margin: 0; max-width: 44ch;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: rgb(242 233 218 / 0.88);
  }
  .hero__acciones { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .hero__direccion {
    position: absolute; right: var(--gutter); bottom: clamp(5.5rem, 11vh, 7.5rem);
    margin: 0; font-family: var(--font-display); font-style: italic; font-size: 1.05rem;
    text-align: right; color: var(--color-humo); display: none;
  }
  @media (min-width: 64rem) { .hero__direccion { display: block; } }
  @media (prefers-reduced-motion: reduce) {
    .hero__imagen :global(img) { animation: none; }
    .letra, [data-hero-aparece] { animation: none; }
  }
</style>
