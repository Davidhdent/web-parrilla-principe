---
/** La casa: quiénes son y por qué vuelve la gente. Solo datos de la investigación (ver docs). */
import type { Lang } from '../data/restaurante';
import { restaurante } from '../data/restaurante';
import { t } from '../i18n/textos';
import Pendiente from './Pendiente.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const tx = t(lang).historia;
const google = restaurante.valoraciones.plataformas.find((p) => p.nombre === 'Google')!;
const fmt = new Intl.NumberFormat(lang === 'es' ? 'es-ES' : 'en-GB');
const nota = lang === 'es' ? google.nota : google.nota.replace(',', '.');
---
<section id="historia" class="historia seccion" aria-labelledby="historia-titulo">
  <div class="contenedor historia__rejilla">
    <figure class="historia__foto" data-revelar-mascara>
      <div class="foto-pendiente">
        <span>{t(lang).galeria.fotoPendiente}<small>{tx.fotoAlt}</small></span>
      </div>
    </figure>

    <div class="historia__texto">
      <span class="marcas" aria-hidden="true"></span>
      <h2 id="historia-titulo" class="titulo-seccion" data-revelar>{tx.titulo}</h2>
      <p class="capitular" data-revelar>{tx.p1}<Pendiente lang={lang} si={tx.p1Pendiente} /></p>
      <p data-revelar>{tx.p2}</p>

      <blockquote class="historia__cita" data-revelar>
        <p>«{tx.cita}»</p>
        <footer>{tx.citaAutor}</footer>
      </blockquote>

      <p data-revelar>{tx.huerta}<Pendiente lang={lang} /></p>

      <dl class="historia__cifras">
        <div>
          <dt>{tx.contadorNota}</dt>
          <dd>{nota}</dd>
        </div>
        <div>
          <dt>{tx.contadorOpiniones}</dt>
          <dd data-contador={google.opiniones} data-formato={lang}>{fmt.format(google.opiniones)}</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .historia__rejilla { display: grid; gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  @media (min-width: 56rem) {
    .historia__rejilla { grid-template-columns: 5fr 6fr; }
    .historia__foto { position: sticky; top: 7rem; }
  }
  .historia__foto { margin: 0; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 2px; }
  @media (min-width: 56rem) { .historia__foto { aspect-ratio: 4 / 5; } }
  .historia__texto { max-width: 36rem; }
  .historia__texto h2 { margin: 1.25rem 0 2.25rem; }
  .historia__texto p { margin: 0 0 1.25rem; }
  .capitular::first-letter {
    float: left;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 4.8em;
    line-height: 0.78;
    padding: 0.08em 0.12em 0 0;
    color: var(--color-brasa-oscura);
  }
  .historia__cita {
    margin: 2.75rem 0;
    padding-inline-start: 1.5rem;
    border-inline-start: 2px solid var(--color-brasa);
  }
  .historia__cita p {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.7rem, 3.2vw, 2.4rem);
    line-height: 1.15;
    margin: 0 0 0.75rem;
  }
  .historia__cita footer { font-size: 0.9rem; color: var(--color-ceniza); }
  .historia__cifras {
    display: flex; flex-wrap: wrap; gap: 2rem 3.5rem;
    margin: 3rem 0 0; padding-top: 2rem; border-top: 1px solid var(--color-hueso-2);
  }
  .historia__cifras div { display: flex; flex-direction: column-reverse; }
  .historia__cifras dd {
    margin: 0; font-family: var(--font-display); font-weight: 300; font-size: clamp(3rem, 6vw, 4.5rem);
    line-height: 1; color: var(--color-brasa-oscura); font-variant-numeric: lining-nums tabular-nums;
  }
  .historia__cifras dt { font-size: 0.9rem; color: var(--color-ceniza); margin-top: 0.4rem; }
</style>
