---
/** Iconos de línea fina (trazo 1.5), coherentes con los filetes del diseño. */
interface Props { nombre: 'telefono' | 'mapa' | 'menu' | 'cerrar' | 'flecha-izq' | 'flecha-der' | 'mas' | 'carta'; class?: string }
const { nombre, class: clase } = Astro.props;
const trazos: Record<Props['nombre'], string> = {
  telefono:
    '<path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
  mapa: '<path d="M12 21s-6-5.3-6-11a6 6 0 0 1 12 0c0 5.7-6 11-6 11z"/><circle cx="12" cy="10" r="2.2"/>',
  menu: '<path d="M4 8h16M4 16h16"/>',
  cerrar: '<path d="M6 6l12 12M18 6L6 18"/>',
  'flecha-izq': '<path d="M15 5l-7 7 7 7"/>',
  'flecha-der': '<path d="M9 5l7 7-7 7"/>',
  mas: '<path d="M12 5v14M5 12h14"/>',
  carta: '<path d="M6 3h12v18H6z"/><path d="M9 8h6M9 12h6M9 16h4"/>',
};
---
<svg class={clase} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={trazos[nombre]} />
